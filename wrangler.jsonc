{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dist-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-05",
  "compatibility_flags": [
    "nodejs_als", // needed by Sentry
  ],
  "logpush": true,
  "preview_urls": false,
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "dev",
    "LOG_ERRORS": true,
    "S3_ENDPOINT": "https://07be8d2fbc940503ca1be344714cb0d1.r2.cloudflarestorage.com",
    "BUCKET_NAME": "dist-prod",
    "ORIGIN_HOST": "https://origin.nodejs.org",
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "preview_bucket_name": "dist-prod",
      "bucket_name": "dist-prod",
    },
  ],
  "env": {
    "staging": {
      "account_id": "07be8d2fbc940503ca1be344714cb0d1",
      "routes": [
        { "pattern": "r2-staging.nodejs.org/*", "zone_name": "nodejs.org" },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "USE_KV": true,
        "LOG_ERRORS": false,
        "S3_ENDPOINT": "https://07be8d2fbc940503ca1be344714cb0d1.r2.cloudflarestorage.com",
        "BUCKET_NAME": "dist-prod",
        "ORIGIN_HOST": "https://origin.nodejs.org",
      },
      "workers_dev": true,
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "preview_bucket_name": "dist-prod",
          "bucket_name": "dist-prod",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "DIRECTORY_CACHE",
          "id": "a8378d5444a2465ca7202ebaa5d8deb1",
        },
      ],
      "cache": {
        "enabled": true,
      },
    },
    "prod": {
      "account_id": "07be8d2fbc940503ca1be344714cb0d1",
      "routes": [
        { "pattern": "nodejs.org/api", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/api/*", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/dist", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/dist/*", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/docs", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/docs/*", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/download", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/download/*", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/metrics", "zone_name": "nodejs.org" },
        { "pattern": "nodejs.org/metrics/*", "zone_name": "nodejs.org" },
        {
          "pattern": "nodejs.org/node-config-schema.json",
          "zone_name": "nodejs.org",
        },
        {
          "pattern": "nodejs.org/llms.txt",
          "zone_name": "nodejs.org",
        },
        { "pattern": "r2.nodejs.org/*", "zone_name": "nodejs.org" },
      ],
      "tail_consumers": [
        {
          "service": "dist-worker-prod-tail",
        },
      ],
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "LOG_ERRORS": false,
        "S3_ENDPOINT": "https://07be8d2fbc940503ca1be344714cb0d1.r2.cloudflarestorage.com",
        "BUCKET_NAME": "dist-prod",
        "ORIGIN_HOST": "https://origin.nodejs.org",
        "USE_KV": true,
        "KV_DIRECTORIES": [
          "metrics/",
          "nodejs/chakracore-nightly/",
          "nodejs/chakracore-rc/",
          "nodejs/chakracore-release/",
          "nodejs/docs/",
          "nodejs/nightly/",
          "nodejs/rc/",
          "nodejs/test/",
          "nodejs/v8-canary/"
        ]
      },
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "preview_bucket_name": "dist-prod",
          "bucket_name": "dist-prod",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "DIRECTORY_CACHE",
          "id": "a8378d5444a2465ca7202ebaa5d8deb1",
        },
      ],
      "cache": {
        "enabled": true,
      },
    },
  },
}
